<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain dark window with no decor. Compose draws everything, and a black
         window background means no white flash between launch and first frame. -->
    <style name="Theme.ArslanTv" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
